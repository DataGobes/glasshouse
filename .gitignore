node_modules/
.DS_Store
*.log

# Claude Code worktree mechanism — never commit these
.claude/

# Complaint builder draft state (resumable-run artifacts)
.complaint-draft-*.json

# Generated complaint dossiers contain personal data — do not commit
dpa-complaint-*/

# Raw scan outputs, screenshots and extracted summaries (default file names
# from scripts/scan.js and extract-summary.js). Scans of real third-party
# sites never belong in the repo; curated examples live under docs/examples/.
glasshouse-*.json
glasshouse-*.png
privacy-summary-*.json
scans/

# Replay fixtures (scan + analysis pairs) contain raw scans of third-party
# sites — keep them local. Only the convention README and our own site's
# fixture are committed. See fixtures/replay/README.md.
fixtures/replay/*
!fixtures/replay/README.md
!fixtures/replay/datagobes.dev/
